#!/bin/bash
# Claude Desktop (3P mode) credential helper for the Cloudflare AI gateway.
#
# Prints {"token": ..., "headers": {...}} as Claude Desktop expects. The gateway
# injects the real Anthropic key itself; it only needs the Cloudflare Access JWT
# in "cf-access-token", so the bearer token is a placeholder.
#
# Reuses pi's cf-access-token script (shared token cache). Browser login only
# happens when the user is present (CLAUDE_HELPER_CONTEXT=interactive/setup-test).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
TOKEN_SCRIPT="$SELF_DIR/../pi/scripts/cf-access-token"

case "${CLAUDE_HELPER_CONTEXT:-interactive}" in
  interactive | setup-test)
    export PI_CF_WAIT=540 ;;            # app timeout is set to 600s
  mid-session-refresh)
    export PI_CF_WAIT=15 ;;             # app clamps this context to 20s
  *)
    export PI_CF_NO_LOGIN=1 ;;          # background / scheduled-task: never open a browser
esac

jwt="$("$TOKEN_SCRIPT")"
jq -cn --arg jwt "$jwt" '{
  token: "cf-gateway",
  headers: {"cf-access-token": $jwt, "X-Requested-With": "xmlhttprequest"}
}'
